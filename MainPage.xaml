<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KurtDhylanMotoShopInventory.MainPage"
             BackgroundColor="#090909"
             Title="Moto Shop Inventory">
    <ScrollView>
      <VerticalStackLayout Padding="18" Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
          <VerticalStackLayout>
            <Label Text="KURT DHYLAN" FontSize="27" FontAttributes="Bold" TextColor="White"/>
            <Label Text="MOTO SHOP • INVENTORY" FontSize="13" TextColor="#E50914" FontAttributes="Bold"/>
          </VerticalStackLayout>
          <Label Grid.Column="1" Text="KD" FontSize="34" FontAttributes="Bold" TextColor="#E50914" VerticalOptions="Center"/>
        </Grid>

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <Border BackgroundColor="#151515" Stroke="#252525" StrokeThickness="1" Padding="12">
            <VerticalStackLayout><Label Text="PRODUCTS" TextColor="#A8A8A8" FontSize="11"/><Label x:Name="ProductCount" Text="0" TextColor="White" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout>
          </Border>
          <Border Grid.Column="1" BackgroundColor="#151515" Stroke="#252525" StrokeThickness="1" Padding="12">
            <VerticalStackLayout><Label Text="SERVICES" TextColor="#A8A8A8" FontSize="11"/><Label x:Name="ServiceCount" Text="0" TextColor="White" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout>
          </Border>
          <Border Grid.Column="2" BackgroundColor="#151515" Stroke="#252525" StrokeThickness="1" Padding="12">
            <VerticalStackLayout><Label Text="LOW STOCK" TextColor="#A8A8A8" FontSize="11"/><Label x:Name="LowStockCount" Text="0" TextColor="#E50914" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout>
          </Border>
        </Grid>

        <Label Text="PRODUCT INVENTORY" TextColor="White" FontSize="19" FontAttributes="Bold"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <SearchBar x:Name="ProductSearch" Placeholder="Search brand, model, product..." TextColor="White" PlaceholderColor="#777" BackgroundColor="#151515" TextChanged="ProductSearch_TextChanged"/>
          <Button Grid.Column="1" Text="+ ADD" BackgroundColor="#E50914" TextColor="White" FontAttributes="Bold" Clicked="AddProduct_Clicked"/>
        </Grid>
        <CollectionView x:Name="ProductList" SelectionMode="None">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Border BackgroundColor="#151515" Stroke="#252525" Padding="13" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                  <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="16"/>
                  <Label Grid.Row="1" Text="{Binding Brand}" TextColor="#E50914"/>
                  <Label Grid.Row="1" Grid.Column="1" Text="{Binding Price, StringFormat='₱{0:N2}'}" TextColor="White" FontAttributes="Bold"/>
                  <Label Grid.Row="2" Text="{Binding Model}" TextColor="#A8A8A8" FontSize="12"/>
                  <Label Grid.Row="2" Grid.Column="1" Text="{Binding Stock, StringFormat='Stock: {0}'}" TextColor="#A8A8A8" FontSize="12"/>
                </Grid>
              </Border>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="SERVICES / LABOR" TextColor="White" FontSize="19" FontAttributes="Bold" Margin="0,8,0,0"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <SearchBar x:Name="ServiceSearch" Placeholder="Search service..." TextColor="White" PlaceholderColor="#777" BackgroundColor="#151515" TextChanged="ServiceSearch_TextChanged"/>
          <Button Grid.Column="1" Text="+ ADD" BackgroundColor="#E50914" TextColor="White" FontAttributes="Bold" Clicked="AddService_Clicked"/>
        </Grid>
        <CollectionView x:Name="ServiceList" SelectionMode="None">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Border BackgroundColor="#151515" Stroke="#252525" Padding="13" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="16"/>
                  <Label Grid.Column="1" Text="{Binding LaborPrice, StringFormat='₱{0:N2}'}" TextColor="#E50914" FontAttributes="Bold"/>
                </Grid>
              </Border>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="REFRESH INVENTORY" BackgroundColor="#222222" TextColor="White" Clicked="Refresh_Clicked"/>
      </VerticalStackLayout>
    </ScrollView>
</ContentPage>
